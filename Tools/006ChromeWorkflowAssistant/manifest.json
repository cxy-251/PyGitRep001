{
  "manifest_version": 3,
  "name": "网页工作流助手",
  "short_name": "工作流助手",
  "version": "0.1.0",
  "description": "在用户当前打开并登录的 Chrome 页面中，辅助快手发布、BOSS 职位整理和 X 时间线提示词提取。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "打开网页工作流助手"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}
