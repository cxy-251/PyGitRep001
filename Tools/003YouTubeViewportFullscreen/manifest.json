{
  "manifest_version": 3,
  "name": "网页全屏助手 for YouTube™",
  "short_name": "网页全屏助手",
  "version": "1.3.0",
  "description": "非官方扩展：让 YouTube 播放器铺满当前网页视口，同时保留浏览器标签栏和地址栏。",
  "homepage_url": "https://github.com/cxy-251/PyGitRep001/tree/main/Tools/003YouTubeViewportFullscreen",
  "minimum_chrome_version": "120",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
